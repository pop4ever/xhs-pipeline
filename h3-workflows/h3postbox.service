[Unit]
Description=h3-postbox video post service (render+TTS+subtitle+mux on p7550)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=david
WorkingDirectory=/home/david/h3postbox
Environment=POSTBOX_DATA=/home/david/h3postbox/data
Environment=COMFY_API=http://127.0.0.1:8189
Environment=EDGE_TTS_PROXY=http://192.168.1.222:7800
ExecStart=/home/david/h3postbox/.venv/bin/uvicorn h3postbox:app --host 0.0.0.0 --port 8190
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
